# The development database listens only on the VPS Tailscale address. Retrieve
# its app password on the VPS with the command documented in README.md.
DATABASE_URL=postgresql://mons_dev_app:replace_with_dev_app_password@replace_with_vps_magicdns_name:5433/mons_dev?sslmode=require
MIGRATION_DATABASE_URL=postgresql://mons_dev_migration:replace_with_dev_migration_password@replace_with_vps_magicdns_name:5433/mons_dev?sslmode=require
MONS_TEST_DATABASE_URL=postgresql://mons_dev_app:replace_with_dev_app_password@replace_with_vps_magicdns_name:5433/mons_dev?sslmode=require
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
MONS_CATALOG_SCHEMA=mons_catalog
MONS_APP_SCHEMA=mons_app
MONS_DATABASE_RUNTIME_USER=mons_dev_app
API_PORT=3000
API_HOST=0.0.0.0
AI_GATEWAY_MODEL=google/gemini-3.7-flash
AI_GATEWAY_MEAL_OBSERVATION_MODEL=google/gemini-3.7-flash
AI_GATEWAY_MEAL_RESOLUTION_MODEL=google/gemini-3.7-flash
AI_GATEWAY_TRANSCRIPTION_MODEL=google/gemini-3.7-flash
# Optional for the standalone local Node server. Cloudflare Workers use the
# credential-free SST Media binding instead.
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_me_for_local_node_only
R2_SECRET_ACCESS_KEY=replace_me_for_local_node_only
R2_BUCKET_NAME=mons

# Required only to publish immutable nutrition releases from this Mac.
CLOUDFLARE_DEFAULT_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_ACCESS_KEY_ID=replace_me_for_nutrition_publish
CLOUDFLARE_SECRET_ACCESS_KEY=replace_me_for_nutrition_publish
