{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mons-api-local",
  "main": "services/api/src/worker.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "placement": { "mode": "smart" },
  "secrets": { "required": ["CLERK_SECRET_KEY"] },
  "vars": {
    "AI_GATEWAY_ID": "mons-dev",
    "CLERK_PUBLISHABLE_KEY": "pk_test_YmlnLWNvdy04Mi5jbGVyay5hY2NvdW50cy5kZXYk",
    "MONS_APP_SCHEMA": "mons_app",
    "MONS_CATALOG_SCHEMA": "mons_catalog",
    "MONS_DEPLOYMENT_SCOPE": "local",
    "MONS_STAGE": "local",
    "MONS_STORAGE_PREFIX": "local",
    "R2_BUCKET_NAME": "mons",
  },
  "hyperdrive": [
    {
      "binding": "Database",
      "id": "8c533f1b36d644fab96b3ebe4cb5bc08",
    },
  ],
  "ai": {
    "binding": "Ai",
    "remote": true,
  },
  "r2_buckets": [
    {
      "binding": "Media",
      "bucket_name": "mons",
    },
  ],
  "env": {
    "dev": {
      "name": "mons-dev-apiscript",
      "routes": [{ "pattern": "api.dev.mons.fit", "custom_domain": true }],
      "secrets": { "required": ["CLERK_SECRET_KEY"] },
      "vars": {
        "AI_GATEWAY_ID": "mons-dev",
        "CLERK_PUBLISHABLE_KEY": "pk_test_YmlnLWNvdy04Mi5jbGVyay5hY2NvdW50cy5kZXYk",
        "MONS_APP_SCHEMA": "mons_app",
        "MONS_CATALOG_SCHEMA": "mons_catalog",
        "MONS_DEPLOYMENT_SCOPE": "dev",
        "MONS_STAGE": "dev",
        "MONS_STORAGE_PREFIX": "dev",
        "R2_BUCKET_NAME": "mons",
      },
      "hyperdrive": [
        {
          "binding": "Database",
          "id": "8c533f1b36d644fab96b3ebe4cb5bc08",
        },
      ],
      "ai": { "binding": "Ai" },
      "r2_buckets": [{ "binding": "Media", "bucket_name": "mons" }],
    },
    "production": {
      "name": "mons-production-apiscript",
      "routes": [{ "pattern": "api.mons.fit", "custom_domain": true }],
      "secrets": { "required": ["CLERK_SECRET_KEY"] },
      "vars": {
        "AI_GATEWAY_ID": "mons-production",
        "CLERK_PUBLISHABLE_KEY": "pk_test_YmlnLWNvdy04Mi5jbGVyay5hY2NvdW50cy5kZXYk",
        "MONS_APP_SCHEMA": "mons_app",
        "MONS_CATALOG_SCHEMA": "mons_catalog",
        "MONS_DEPLOYMENT_SCOPE": "production",
        "MONS_STAGE": "production",
        "MONS_STORAGE_PREFIX": "production",
        "R2_BUCKET_NAME": "mons",
      },
      "hyperdrive": [
        {
          "binding": "Database",
          "id": "0d5ed6f6c3c94a6c8efca2deb51ea2ea",
        },
      ],
      "ai": { "binding": "Ai" },
      "r2_buckets": [{ "binding": "Media", "bucket_name": "mons" }],
    },
  },
}
