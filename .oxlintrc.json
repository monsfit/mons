{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "plugins": ["import", "typescript", "unicorn", "vitest"],
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "vitest/no-standalone-expect": "off"
      }
    }
  ]
}
