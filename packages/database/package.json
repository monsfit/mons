{
  "name": "@regolith/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "lint": "oxlint src --deny-warnings",
    "migrate": "oxnode --env-file-if-exists=../../.env src/migrate.ts",
    "test": "vitest run src",
    "typecheck": "tsgo -p tsconfig.json"
  },
  "dependencies": {
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@oxc-node/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  }
}
